# Credenciais da API Sisatec
SISATEC_CODIGO=SEU_CODIGO
SISATEC_KEY=SUA_CHAVE

# Modo mock (true = sem banco/Sisatec, para desenvolvimento)
USE_MOCK=true

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL (necessário quando USE_MOCK=false)
DATABASE_URL=postgresql+asyncpg://frotagov:frotagov@localhost/frotagov

# Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASS=TROQUE_ESTA_SENHA

# Ambiente: development | production
ENV=development

# Intervalo do scheduler intraday (minutos)
SYNC_INTERVAL_MIN=3
